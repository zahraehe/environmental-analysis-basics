# Simple Air Quality Analyzer - Beginner Version
print("Simple Air Quality Analyzer")
print("=" * 40)

pm25 = float(input("Enter PM2.5 value (μg/m³): "))
pm10 = float(input("Enter PM10 value (μg/m³): "))

print("\n" + "=" * 40)
print(" Analysis Results:")

# Analyze PM2.5
print(f"\nPM2.5 Particles: {pm25} μg/m³")
if pm25 <= 12:
    print("Status: Good - Safe for everyone")
elif pm25 <= 35.4:
    print("Status: Moderate - Sensitive groups be cautious")
elif pm25 <= 55.4:
    print("Status: Unhealthy for sensitive groups")
elif pm25 <= 150.4:
    print("Status: Unhealthy - Everyone should be cautious")
else:
    print("Status: Hazardous - Avoid going outside")

# Analyze PM10
print(f"\nPM10 Particles: {pm10} μg/m³")
if pm10 <= 54:
    print("Status: Good - Safe for everyone")
elif pm10 <= 154:
    print("Status: Moderate - Sensitive groups be cautious")
elif pm10 <= 254:
    print("Status: Unhealthy for sensitive groups")
elif pm10 <= 354:
    print("Status: Unhealthy - Everyone should be cautious")
else:
    print("Status: Hazardous - Avoid going outside")

# Overall recommendations
print("\n" + "=" * 40)
print("Health Recommendations:")

if pm25 <= 12 and pm10 <= 54:
    print("Excellent conditions! You can do outdoor activities")
elif pm25 <= 35.4 and pm10 <= 154:
    print("Acceptable conditions - Sensitive people should limit exposure")
elif pm25 <= 55.4 and pm10 <= 254:
    print("Children, elderly, and sick people should avoid outdoor activities")
else:
    print("Everyone should avoid outdoor activities")

print("\n" + "=" * 40)
print("PM2.5 are smaller and more dangerous particles")
