# analysis air quality
print("🌍 تحلیل کننده ساده کیفیت هوا")
print("=" * 40)

# دریافت داده از کاربر
pm25 = float(input("لطفا مقدار PM2.5 را وارد کنید (μg/m³): "))
pm10 = float(input("لطفا مقدار PM10 را وارد کنید (μg/m³): "))

print("\n" + "=" * 40)
print("📊 نتایج تحلیل:")

# تحلیل PM2.5
print(f"\nذرات PM2.5: {pm25} μg/m³")
if pm25 <= 12:
    print("✅ وضعیت: خوب - مناسب برای همه")
elif pm25 <= 35.4:
    print("🟡 وضعیت: متوسط - حساسیت‌داران مراقب باشند")
elif pm25 <= 55.4:
    print("🟠 وضعیت: ناسالم برای گروه‌های حساس")
elif pm25 <= 150.4:
    print("🔴 وضعیت: ناسالم - همه مراقب باشند")
else:
    print("💀 وضعیت: بسیار خطرناک - از منزل خارج نشوید")

# تحلیل PM10
print(f"\nذرات PM10: {pm10} μg/m³")
if pm10 <= 54:
    print("✅ وضعیت: خوب - مناسب برای همه")
elif pm10 <= 154:
    print("🟡 وضعیت: متوسط - حساسیت‌داران مراقب باشند")
elif pm10 <= 254:
    print("🟠 وضعیت: ناسالم برای گروه‌های حساس")
elif pm10 <= 354:
    print("🔴 وضعیت: ناسالم - همه مراقب باشند")
else:
    print("💀 وضعیت: بسیار خطرناک - از منزل خارج نشوید")

# تحلیل کلی
print("\n" + "=" * 40)
print("🎯 توصیه‌های سلامت:")

if pm25 <= 12 and pm10 <= 54:
    print("✅ شرایط عالی! می‌توانید فعالیت‌های بیرون را انجام دهید")
elif pm25 <= 35.4 and pm10 <= 154:
    print("🟡 شرایط قابل قبول - افراد حساس محدودیت قائل شوند")
elif pm25 <= 55.4 and pm10 <= 254:
    print("🟠 کودکان، سالمندان و بیماران در فضای باز فعالیت نکنند")
else:
    print("🔴 همه افراد از فعالیت در فضای باز خودداری کنند")

print("\n" + "=" * 40)
print("💡 نکته: PM2.5 ذرات ریزتر و خطرناک‌تر هستند")
